{
  "name": "proyecto-final",
  "version": "1.0.0",
  "private": true,
  "main": "main/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "electron:dev": "concurrently \"npm run start-frontend\" \"npm run start-electron\"",
    "start-frontend": "cd frontend && npm run dev",
    "start-electron": "wait-on http://localhost:5173 && electron ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "framer-motion": "^12.11.0",
    "nodemailer": "^6.10.1",
    "react-modal": "^3.16.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.2",
    "@types/nodemailer": "^6.4.17",
    "concurrently": "^8.2.2",
    "electron": "^36.1.0",
    "electron-builder": "^24.6.0",
    "electron-rebuild": "^3.2.9",
    "wait-on": "^7.2.0"
  }
}
