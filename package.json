{
  "name": "proyecto-final",
  "version": "1.0.0",
  "description": "Aplicación de escritorio desarrollada con Electron y React.",
  "author": "Tu Nombre",
  "private": true,
  "main": "main/main.js",
  "type": "module",
  "scripts": {
    "start":  "concurrently \"npm run dev --prefix frontend\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "electron-builder",
    "electron:dev": "concurrently \"npm run start-frontend\" ",
    "start-frontend": "cd frontend && npm run dev",
    "start-electron": "wait-on http://localhost:5173 && electron .",
    "icon": "builder.icon",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "3dmol": "^2.4.2",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "framer-motion": "^12.11.0",
    "nodemailer": "^6.10.1",
    "papaparse": "^5.5.3",
    "react-hot-toast": "^2.5.2",
    "react-modal": "^3.16.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "three": "^0.176.0",
    "vanta": "^0.5.24"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.2",
    "@types/nodemailer": "^6.4.17",
    "@types/papaparse": "^5.3.16",
    "@types/three": "^0.176.0",
    "concurrently": "^8.2.2",
    "electron": "^36.1.0",
    "electron-builder": "^24.6.0",
    "electron-rebuild": "^3.2.9",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.tuempresa.proyectofinal",
    "productName": "ProyectoFinal",
    "files": [
      "build/**/*",
      "main/**/*",
      "preload.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
  }
}
